        "pages": [
          "index",
          "funding-scope",
          "reviewer-guide",
          "business-plan",
          "ai-disclosure",
          "budget",
          "team-risk-profile",
          "pilot-plan",
          "monitoring-plan",
          "submission-requirements",
          "market-positioning"
        ]
      },
      {
        "group": "Contracts and verification",
        "pages": [
          "smart-contracts/overview",
          "smart-contracts/architecture",
          "smart-contracts/deployment",
          "testnet-release",
          "threat-model",
          "testnet-deployment",
          "security-readiness"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Docs",
