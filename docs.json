{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "CoverFi",
  "colors": {
    "primary": "#D4AF37",
    "light": "#FCD34D",
    "dark": "#B45309"
  },
  "favicon": "/favicon.svg",
  "mintlifyBranding": false,
  "seo": {
    "indexing": "all"
  },
  "chat": {
    "enabled": true
  },
  "navigation": {
    "pages": [
      {
        "group": "Start",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Trust & operations",
        "pages": [
          "security-trust",
          "economics",
          "backend-operations",
          "legal"
        ]
      },
      {
        "group": "Product",
        "pages": [
          "landing-site",
          "app",
          "ai"
        ]
      },
      {
        "group": "Smart Contracts Ecosystem",
        "pages": [
          "smart-contracts/overview",
          "smart-contracts/protection-engine",
          "smart-contracts/protected-balance-vault",
          "smart-contracts/premium-vault",
          "smart-contracts/reserve-vault",
          "smart-contracts/oracle-adapter",
          "smart-contracts/registries",
          "smart-contracts/deployment"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Docs",
        "href": "https://docs.coverfi.space/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://app.coverfi.space"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/CoverFI-space/coverfi-contracts.git"
    }
  }
}
