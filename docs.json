{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "CoverFi",
  "colors": {
    "primary": "#D4AF37",
    "light": "#FCD34D",
    "dark": "#B45309"
  },
  "favicon": "/favicon.svg",
  "mintlifyBranding": false,
  "seo": {
    "indexing": "all"
  },
  "chat": {
    "enabled": false
  },
  "navigation": {
